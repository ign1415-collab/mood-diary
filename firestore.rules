rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validEntry(entryId) {
      return entryId.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.keys().hasOnly(['mood', 'note', 'reasonIds', 'weather', 'createdAt', 'updatedAt'])
        && request.resource.data.mood in ['happy', 'calm', 'excited', 'neutral', 'depressed', 'anxious', 'tired', 'angry']
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 300
        && (!request.resource.data.keys().hasAny(['reasonIds']) || (
          request.resource.data.reasonIds is list
          && request.resource.data.reasonIds.size() <= 8
        ))
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.createdAt <= request.resource.data.updatedAt
        && request.resource.data.updatedAt <= request.time
        && (!request.resource.data.keys().hasAny(['weather']) || validWeather(request.resource.data.weather));
    }

    function validWeather(weather) {
      return weather.keys().hasOnly(['icon', 'temperature', 'description', 'location', 'observedAt'])
        && weather.keys().hasAll(['icon', 'description'])
        && weather.icon is string
        && weather.icon.size() <= 8
        && weather.description is string
        && weather.description.size() <= 100
        && (
          !weather.keys().hasAny(['temperature', 'location', 'observedAt'])
          || (
            weather.keys().hasAll(['temperature', 'location', 'observedAt'])
            && weather.temperature is int
            && weather.temperature >= -100
            && weather.temperature <= 100
            && weather.location is string
            && weather.location.size() <= 100
            && weather.observedAt is timestamp
            && weather.observedAt <= request.time
          )
        );
    }

    function validReasonTag(tagId) {
      return tagId.size() > 0
        && tagId.size() <= 100
        && request.resource.data.keys().hasOnly(['label', 'active', 'builtIn', 'createdAt', 'updatedAt'])
        && request.resource.data.label is string
        && request.resource.data.label.size() > 0
        && request.resource.data.label.size() <= 8
        && request.resource.data.active is bool
        && request.resource.data.builtIn is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.createdAt <= request.resource.data.updatedAt
        && request.resource.data.updatedAt <= request.time;
    }

    function isDefaultReasonTag(tagId) {
      return tagId in ['person', 'sleep', 'health', 'study', 'work'];
    }

    function validReasonTagIdentity(tagId) {
      return (isDefaultReasonTag(tagId) && request.resource.data.builtIn == true)
        || (!isDefaultReasonTag(tagId) && request.resource.data.builtIn == false);
    }

    match /users/{userId} {
      allow read: if signedInAs(userId);
      allow create: if signedInAs(userId)
        && request.resource.data.keys().hasOnly(['currentGeneration', 'createdAt', 'updatedAt'])
        && request.resource.data.currentGeneration is string
        && request.resource.data.currentGeneration.size() <= 100;
      allow update: if signedInAs(userId)
        && request.resource.data.keys().hasOnly(['currentGeneration', 'createdAt', 'updatedAt'])
        && request.resource.data.currentGeneration is string
        && request.resource.data.currentGeneration.size() <= 100
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      match /reasonTags/{tagId} {
        allow read: if signedInAs(userId);
        allow create: if signedInAs(userId)
          && validReasonTag(tagId)
          && validReasonTagIdentity(tagId);
        allow update: if signedInAs(userId)
          && validReasonTag(tagId)
          && validReasonTagIdentity(tagId)
          && request.resource.data.builtIn == resource.data.builtIn
          && (!resource.data.builtIn || request.resource.data.label == resource.data.label);
        allow delete: if false;
      }

      match /diaries/{generationId} {
        allow read, delete: if signedInAs(userId);
        allow create, update: if signedInAs(userId)
          && generationId.size() <= 100
          && request.resource.data.keys().hasOnly(['createdAt', 'restoredAt', 'count'])
          && request.resource.data.createdAt is timestamp
          && request.resource.data.restoredAt is timestamp
          && request.resource.data.count is int
          && request.resource.data.count >= 0;

        match /entries/{entryId} {
          allow read, delete: if signedInAs(userId);
          allow create, update: if signedInAs(userId) && validEntry(entryId);
        }
      }
    }
  }
}
